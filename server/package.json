{
  "name": "zimbi-api",
  "version": "0.1.0",
  "description": "ZIMBI Global Payments API - Fastify, PostgreSQL, Paystack integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "zimbi",
    "payments",
    "infrastructure",
    "fastify",
    "postgresql",
    "paystack"
  ],
  "author": "ZIMBI",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "pg": "^8.13.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11"
  }
}
